{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "openppl",
  "word": "identifier",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "section_header"
          },
          {
            "type": "SYMBOL",
            "name": "when_statement"
          },
          {
            "type": "SYMBOL",
            "name": "hand_range"
          }
        ]
      }
    },
    "section_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "##"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "##"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": "[^\\r\\n]*"
          }
        ]
      }
    },
    "when_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "when_kw"
        },
        {
          "type": "FIELD",
          "name": "condition",
          "content": {
            "type": "SYMBOL",
            "name": "_expression"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "consequence",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "action_statement"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "set_statement"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "return_statement"
                  }
                ]
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "action_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "action",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "argument",
              "content": {
                "type": "SYMBOL",
                "name": "_expression"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "force_kw"
        }
      ]
    },
    "set_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "set_kw"
        },
        {
          "type": "FIELD",
          "name": "variable",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        }
      ]
    },
    "return_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "return_kw"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_expression"
          }
        },
        {
          "type": "SYMBOL",
          "name": "force_kw"
        }
      ]
    },
    "hand_range": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[2-9TJQKA]{2}[sSoO]?"
      }
    },
    "_expression": {
      "type": "SYMBOL",
      "name": "_logical_or"
    },
    "_logical_or": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "or_expression"
        },
        {
          "type": "SYMBOL",
          "name": "_logical_xor"
        }
      ]
    },
    "or_expression": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_logical_or"
          },
          {
            "type": "SYMBOL",
            "name": "or_kw"
          },
          {
            "type": "SYMBOL",
            "name": "_logical_xor"
          }
        ]
      }
    },
    "_logical_xor": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "xor_expression"
        },
        {
          "type": "SYMBOL",
          "name": "_logical_and"
        }
      ]
    },
    "xor_expression": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_logical_xor"
          },
          {
            "type": "SYMBOL",
            "name": "xor_kw"
          },
          {
            "type": "SYMBOL",
            "name": "_logical_and"
          }
        ]
      }
    },
    "_logical_and": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "and_expression"
        },
        {
          "type": "SYMBOL",
          "name": "_logical_not"
        }
      ]
    },
    "and_expression": {
      "type": "PREC_LEFT",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_logical_and"
          },
          {
            "type": "SYMBOL",
            "name": "and_kw"
          },
          {
            "type": "SYMBOL",
            "name": "_logical_not"
          }
        ]
      }
    },
    "_logical_not": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "not_expression"
        },
        {
          "type": "SYMBOL",
          "name": "_comparison"
        }
      ]
    },
    "not_expression": {
      "type": "PREC",
      "value": 4,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "not_kw"
          },
          {
            "type": "SYMBOL",
            "name": "_comparison"
          }
        ]
      }
    },
    "_comparison": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comparison_expression"
        },
        {
          "type": "SYMBOL",
          "name": "_arithmetic_additive"
        }
      ]
    },
    "comparison_expression": {
      "type": "PREC_LEFT",
      "value": 5,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_arithmetic_additive"
          },
          {
            "type": "FIELD",
            "name": "operator",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "="
                },
                {
                  "type": "STRING",
                  "value": "!="
                },
                {
                  "type": "STRING",
                  "value": "<="
                },
                {
                  "type": "STRING",
                  "value": ">="
                },
                {
                  "type": "STRING",
                  "value": "<"
                },
                {
                  "type": "STRING",
                  "value": ">"
                },
                {
                  "type": "STRING",
                  "value": "~~"
                }
              ]
            }
          },
          {
            "type": "SYMBOL",
            "name": "_arithmetic_additive"
          }
        ]
      }
    },
    "_arithmetic_additive": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "additive_expression"
        },
        {
          "type": "SYMBOL",
          "name": "_arithmetic_multiplicative"
        }
      ]
    },
    "additive_expression": {
      "type": "PREC_LEFT",
      "value": 6,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_arithmetic_additive"
          },
          {
            "type": "FIELD",
            "name": "operator",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "+"
                },
                {
                  "type": "STRING",
                  "value": "-"
                }
              ]
            }
          },
          {
            "type": "SYMBOL",
            "name": "_arithmetic_multiplicative"
          }
        ]
      }
    },
    "_arithmetic_multiplicative": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "multiplicative_expression"
        },
        {
          "type": "SYMBOL",
          "name": "_relative_quantity"
        }
      ]
    },
    "multiplicative_expression": {
      "type": "PREC_LEFT",
      "value": 7,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_arithmetic_multiplicative"
          },
          {
            "type": "FIELD",
            "name": "operator",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "*"
                },
                {
                  "type": "STRING",
                  "value": "/"
                },
                {
                  "type": "SYMBOL",
                  "name": "mod_kw"
                }
              ]
            }
          },
          {
            "type": "SYMBOL",
            "name": "_relative_quantity"
          }
        ]
      }
    },
    "_relative_quantity": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "relative_quantity"
        },
        {
          "type": "SYMBOL",
          "name": "_unary"
        }
      ]
    },
    "relative_quantity": {
      "type": "PREC",
      "value": 8,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "percentage"
              },
              {
                "type": "SYMBOL",
                "name": "_bare_fraction"
              }
            ]
          },
          {
            "type": "FIELD",
            "name": "of",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            }
          }
        ]
      }
    },
    "_bare_fraction": {
      "type": "PREC",
      "value": 8,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "number"
          },
          {
            "type": "STRING",
            "value": "/"
          },
          {
            "type": "SYMBOL",
            "name": "number"
          }
        ]
      }
    },
    "_unary": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "unary_expression"
        },
        {
          "type": "SYMBOL",
          "name": "_primary"
        }
      ]
    },
    "unary_expression": {
      "type": "PREC",
      "value": 9,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "-"
          },
          {
            "type": "SYMBOL",
            "name": "_primary"
          }
        ]
      }
    },
    "_primary": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "parenthesized_expression"
        },
        {
          "type": "SYMBOL",
          "name": "hand_expression"
        },
        {
          "type": "SYMBOL",
          "name": "board_expression"
        },
        {
          "type": "SYMBOL",
          "name": "percentage"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "parenthesized_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "_expression"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "hand_expression": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[Hh][Aa][Nn][Dd]\\$[A-Za-z0-9]+"
        }
      }
    },
    "board_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "PATTERN",
              "value": "[Bb][Oo][Aa][Rr][Dd]\\$[A-Za-z0-9]+"
            }
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "suited",
              "content": {
                "type": "SYMBOL",
                "name": "suited_kw"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]+(\\.[0-9]+)?"
      }
    },
    "percentage": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]+(\\.[0-9]+)?%"
      }
    },
    "identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z_$][A-Za-z0-9_$]*"
      }
    },
    "when_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[wW][hH][eE][nN]"
        }
      }
    },
    "force_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[fF][oO][rR][cC][eE]"
        }
      }
    },
    "set_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[sS][eE][tT]"
        }
      }
    },
    "return_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[rR][eE][tT][uU][rR][nN]"
        }
      }
    },
    "and_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[aA][nN][dD]"
        }
      }
    },
    "or_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[oO][rR]"
        }
      }
    },
    "xor_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[xX][oO][rR]"
        }
      }
    },
    "not_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[nN][oO][tT]"
        }
      }
    },
    "mod_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[mM][oO][dD]"
        }
      }
    },
    "suited_kw": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[sS][uU][iI][tT][eE][dD]"
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}